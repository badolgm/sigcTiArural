# Variables de entorno para el frontend (Vite)
VITE_AI_API_BASE=https://sigct-backend.onrender.com
VITE_API_URL=https://api.sigct-rural.com
VITE_AI_INFERENCE_URL=https://api.sigct-rural.com/api/v3/ai/inference/

# --- NUEVO: Moldes para la Base de Datos (Sin claves reales) ---
DB_NAME=nombre_de_tu_db
DB_USER=usuario_db
DB_PASSWORD=tu_clave_aqui
DB_HOST=localhost
DB_PORT=5432

# --- Backend Django: seguridad (Día 14-15, Bloque 1) ---
# DJANGO_DEBUG=true SOLO en desarrollo local. En cualquier despliegue real debe
# quedar en false (o simplemente omitirse: el default ya es false).
DJANGO_DEBUG=true

# Obligatoria cuando DJANGO_DEBUG=false (el backend no arranca sin ella en ese
# caso). En desarrollo con DJANGO_DEBUG=true puede omitirse: se usa una clave
# insegura de desarrollo, claramente marcada como tal.
# Generar una real con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-real-en-produccion

# Lista separada por comas. En desarrollo con DJANGO_DEBUG=true, si se omite
# esta variable el default ya es localhost,127.0.0.1 (no hace falta declararla).
ALLOWED_HOSTS=localhost,127.0.0.1

# Whitelist de orígenes CORS, separada por comas (sin barra final). Si se deja
# vacía: en DJANGO_DEBUG=true se permite cualquier origen (conveniencia local);
# en DJANGO_DEBUG=false no se permite ninguno hasta declarar esta variable.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
